# Imagem de DESENVOLVIMENTO do micro de IA. Build a partir da RAIZ do repositório.
FROM node:22-bookworm-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app/ai-micro-services
COPY ai-micro-services/package.json ai-micro-services/yarn.lock ai-micro-services/.yarnrc.yml ./
RUN yarn install --immutable
COPY ai-micro-services/ ./
ENV TZ=UTC
EXPOSE 4000
CMD ["node", "src/server.js"]
