# ===== Email micro (só loopback; /send não tem auth própria) =====
PORT=9999
EMAIL_SERVICE_KEY=   # mesmo valor do back
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BASE_URL_API=https://api.SEU-DOMINIO          # pixel de abertura / clique rastreado (público)
NEST_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/email
# Assinatura das URLs de rastreio (pixel/clique): HMAC-SHA256(sentId|email).
# PRECISA ser o MESMO valor do JWT_ACCESS_SECRET do back (o back valida com ele).
TRACKING_SIGN_SECRET=
