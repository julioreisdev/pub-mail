# Imagem de DESENVOLVIMENTO do micro de e-mail. Build a partir da RAIZ do repositório.
FROM node:22-bookworm-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app/email-micro-services
COPY email-micro-services/package.json email-micro-services/yarn.lock email-micro-services/.yarnrc.yml ./
RUN yarn install --immutable
COPY email-micro-services/ ./
ENV TZ=UTC
EXPOSE 9999
CMD ["node", "server.js"]
