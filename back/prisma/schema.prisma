// ============================================================================
// System Settings (singleton: id sempre = 1)
// ----------------------------------------------------------------------------
// Substitui as envs:
//   - GROQ_API_KEYS (CSV de chaves)
//   - RESEND_API_KEY
//   - WEBCHAT_EDGE_IP
//   - CERTBOT_EMAIL
// Configurado pelo front em "Conta & Domínios" > "Integrações".
// ============================================================================
// Chaves de API por organização (isolamento multi-tenant). system_settings ficou só com infra.
model organization_settings {
  organization_id       String   @id @db.Char(36)
  groq_api_keys         String?  @db.Text
  cerebras_api_keys     String?  @db.Text
  gemini_api_keys       String?  @db.Text
  mistral_api_keys      String?  @db.Text
  openrouter_api_keys   String?  @db.Text
  sambanova_api_keys    String?  @db.Text
  resend_api_key        String?  @db.VarChar(500)
  resend_webhook_secret String?  @db.VarChar(255)
  created_at            DateTime @default(now()) @db.DateTime(0)
  updated_at            DateTime @updatedAt @db.DateTime(0)
}

// SÓ infra da plataforma (singleton id=1). Chaves de API vivem em organization_settings.
model system_settings {
  id                   Int      @id @default(1)
  webchat_edge_ip      String?  @db.VarChar(45)
  certbot_email        String?  @db.VarChar(255)
  created_at           DateTime @default(now()) @db.DateTime(0)
  updated_at           DateTime @updatedAt @db.DateTime(0)
}

// Idempotência dos webhooks do Resend (svix-id). Se já existe, ignora reentrega.
model email_webhook_events {
  id         String   @id @db.VarChar(255)
  created_at DateTime @default(now()) @db.DateTime(0)
}

// Teste A/B: envia variantes p/ uma % da base; depois da janela, o vencedor
// (por abertura/clique) vai p/ o restante. FK/cascade no banco.
model email_ab_tests {
  id                String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  organization_id   String   @db.Char(36)
  project_id        String   @db.Char(36)
  name              String   @db.VarChar(255)
  status            String   @default("testing") @db.VarChar(16) // testing|completed|canceled
  test_percent      Int      @default(30)
  winner_metric     String   @default("open") @db.VarChar(10) // open|click
  decision_at       DateTime @db.DateTime(0)
  test_emails       Json? // e-mails usados no teste (excluídos do envio final)
  winner_variant_id String?  @db.Char(36)
  winner_sent_id    String?  @db.Char(36)
  error_message     String?  @db.VarChar(255)
  created_at        DateTime @default(now()) @db.DateTime(0)
  updated_at        DateTime @updatedAt @db.DateTime(0)

  variants          email_ab_variants[]

  @@index([status, decision_at], map: "idx_ab_tests_due")
  @@index([project_id], map: "idx_ab_tests_project")
  @@index([organization_id], map: "idx_ab_tests_org")
}

model email_ab_variants {
  id               String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  ab_test_id       String   @db.Char(36)
  label            String   @db.VarChar(8) // A, B, C, D
  subject          String   @db.VarChar(255)
  body_html        String?  @db.LongText
  builder_model    Json?
  test_sent_id     String?  @db.Char(36) // disparo do teste (fonte das métricas)
  recipients_count Int      @default(0)
  created_at       DateTime @default(now()) @db.DateTime(0)

  test             email_ab_tests @relation(fields: [ab_test_id], references: [id], onDelete: Cascade)

  @@index([ab_test_id], map: "idx_ab_variants_test")
}

// Gatilhos por comportamento: quando um lead ABRE ou CLICA num e-mail do projeto,
// executa uma ação (adicionar tag ou enviar template). FK/cascade no banco.
model email_behavior_triggers {
  id              String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  organization_id String   @db.Char(36)
  project_id      String   @db.Char(36)
  event           String   @db.VarChar(16) // OPEN | CLICK
  action          String   @db.VarChar(24) // ADD_TAG | SEND_TEMPLATE
  tags            Json? // para ADD_TAG
  template_id     String?  @db.Char(36) // para SEND_TEMPLATE
  // Frequência: { type:'once'|'unlimited'|'cooldown', value?, unit?:'minutes'|'hours'|'days' }
  frequency       Json?
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.DateTime(0)
  updated_at      DateTime @updatedAt @db.DateTime(0)

  @@index([project_id, event, active], map: "idx_email_behavior_triggers_lookup")
  @@index([organization_id], map: "idx_email_behavior_triggers_org")
}

// Registro de disparos por (gatilho, lead) — controla frequência (once/cooldown).
model email_behavior_trigger_fires {
  trigger_id    String    @db.Char(36)
  lead_id       String    @db.Char(36)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  fired_count   Int       @default(1)
  last_fired_at DateTime? @db.DateTime(0)

  @@id([trigger_id, lead_id])
}

// ===================== MÓDULO TELEGRAM =====================
// Bots cadastrados por organização (credencial = token; nome = apelido no Pub Mail).
// Base do módulo: Grupos/Links/Broadcasts/DMs vão referenciar telegram_bots.
model telegram_bots {
  id              String               @id @default(dbgenerated("(uuid())")) @db.Char(36)
  organization_id String               @db.Char(36)
  name            String               @db.VarChar(255) // apelido escolhido no Pub Mail
  token           String               @db.VarChar(255) // credencial do bot (BotFather)
  tg_bot_id       BigInt?              @db.BigInt // id numérico do bot no Telegram (getMe)
  username        String?              @db.VarChar(255) // @username do bot
  first_name      String?              @db.VarChar(255) // nome real do bot no Telegram
  test_chat_id    BigInt?              @db.BigInt // chat privado que falou com o bot (p/ msg de teste)
  status          telegram_bots_status @default(ACTIVE)
  webhook_set     Boolean              @default(false)
  webhook_secret  String?              @db.VarChar(64)
  last_error      String?              @db.Text
  last_checked_at DateTime?            @db.DateTime(0)
  flood_until     DateTime?            @db.DateTime(3) // até quando o Telegram está barrando envios (429 flood-wait)
  created_at      DateTime             @default(now()) @db.DateTime(0)
  updated_at      DateTime             @updatedAt @db.DateTime(0)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_telegram_bots_org")

  @@unique([organization_id, tg_bot_id], map: "uk_tgbot_org_botid")
  @@index([organization_id], map: "idx_telegram_bots_org")
}

enum telegram_bots_status {
  ACTIVE
  BANNED
  ERROR
}

// Contato (lead) que conversou com um bot em DM.
model telegram_contacts {
  id                String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  organization_id   String                  @db.Char(36)
  bot_id            String                  @db.Char(36)
  tg_user_id        BigInt                  @db.BigInt
  first_name        String?                 @db.VarChar(255)
  last_name         String?                 @db.VarChar(255)
  username          String?                 @db.VarChar(255)
  tags              Json?
  attributes        Json?
  last_message_text String?                 @db.Text
  last_message_at   DateTime?               @db.DateTime(0)
