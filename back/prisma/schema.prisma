  number                Int
  protocol              String                   @db.VarChar(24)
  session_id            String?                  @db.Char(36)
  chat_id               String?                  @db.VarChar(64)
  contact_id            String?                  @db.Char(36)
  customer_id           String?                  @db.Char(36)
  category              String                   @db.VarChar(40)
