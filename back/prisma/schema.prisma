  description           String?                  @db.Text
  priority              String                   @default("normal") @db.VarChar(10)
  status                String                   @default("open") @db.VarChar(10)
  assigned_user_id      String?                  @db.Char(36)
  first_response_due_at DateTime?                @db.DateTime(3)
  first_response_at     DateTime?                @db.DateTime(3)
  sla_due_at            DateTime?                @db.DateTime(3)
  sla_warned_at         DateTime?                @db.DateTime(3)
  sla_breached_at       DateTime?                @db.DateTime(3)
  resolved_at           DateTime?                @db.DateTime(3)
  closed_at             DateTime?                @db.DateTime(3)
  reopen_count          Int                      @default(0)
  media_ids             Json?
