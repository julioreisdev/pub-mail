# ===== Back (NestJS) — copie para back/.env e preencha =====
PORT=8000
# Banco: o RUNTIME usa DATABASE_HOST/USER/PASS/NAME/PORT; DATABASE_URL só o CLI do Prisma (migrate/generate)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=pubmail
DATABASE_PASS=
DATABASE_NAME=pubmail
DATABASE_URL=mysql://pubmail:SENHA@127.0.0.1:3306/pubmail
DATABASE_POOL_LIMIT=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# JWT (gere valores longos e aleatórios: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Timeouts do pool MySQL (ms). Opcionais — defaults: connect 10000, acquire 30000
# DATABASE_CONNECT_TIMEOUT=10000
# DATABASE_ACQUIRE_TIMEOUT=30000
# Micros (loopback) + chaves compartilhadas com eles
IA_SERVICE_URL=http://127.0.0.1:4000
IA_SERVICE_KEY=
EMAIL_SERVICE_URL=http://127.0.0.1:9999
EMAIL_SERVICE_KEY=
# URLs públicas do back (webhooks do Telegram/pagamentos, formulário de captação, tracking)
PUBLIC_API_URL=https://api.SEU-DOMINIO
BASE_API_URL=https://api.SEU-DOMINIO
# Rastreio de e-mail: URLs de pixel/clique SEM assinatura só valem para envios
# criados antes desta data (links legados). Default 2026-09-26T23:59:59Z.
# TRACKING_SIGNATURE_CUTOFF=2026-09-26T23:59:59Z
# Webchat / domínios de cliente
WEBCHAT_FRONT_DIST=/opt/pub-mail/front/vite/dist
WEBCHAT_BACKEND_INTERNAL_URL=http://127.0.0.1:8000
WEBCHAT_DOMAIN_BIND_PROVIDER=CERTBOT
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
CERTBOT_BIN=certbot
CERTBOT_MODE=nginx
# Certbot — extras opcionais (defaults do código funcionam no runbook padrão):
# CERTBOT_MODE aceita nginx | standalone | webroot (webroot exige CERTBOT_WEBROOT_PATH)
# CERTBOT_WEBROOT_PATH=
# CERTBOT_STAGING=false            # true = ambiente de teste do Let's Encrypt
# CERTBOT_TIMEOUT_MS=180000
# CERTBOT_STATE_DIR=               # se definido, usa config/work/logs próprios abaixo
# CERTBOT_CONFIG_DIR=
# CERTBOT_WORK_DIR=
# CERTBOT_LOGS_DIR=
# CERTBOT_EXTRA_ARGS=              # args adicionais passados ao certbot
# Webchat — memória de sessão (nº de mensagens mantidas; 4..100, default 24)
# WEBCHAT_SESSION_HISTORY_LIMIT=24
# WEBCHAT_HISTORY_LIMIT=24         # alias legado
# Timeout duro do back -> micro de IA (ms, default 90000). O back envia deadline_ms=85000 ao micro
# AI_CALL_TIMEOUT_MS=90000
# Custos em tokens
EMAIL_TOKENS_FOR_ONE_LEAD=0
EMAIL_TOKENS_FOR_ONE_TEMPLATE=0
WEBCHAT_TOKENS_PER_MESSAGE=0
SOCIAL_POST_SCHEDULE_TOKENS_COST=0
AVATAR_GENERATION_TOKENS_COST=0
# Limites / opcionais
HTTP_BODY_LIMIT=25mb
# Upload de mídia em posts (bytes). Defaults do código se omitidos
# UPLOAD_MAX_FILE_SIZE_BYTES=
# POSTS_MAX_FILE_SIZE_BYTES=
# POSTS_MAX_FILES=
# POSTS_TOKENS_PER_MEDIA_MB=0
# Base pública das imagens do construtor de e-mail (default: BASE_API_URL)
# EMAIL_ASSETS_BASE=
# Base pública da mídia dos posts sociais (default: BASE_API_URL)
# SOCIAL_POST_MEDIA_BASE_URL=
# Swagger: em produção fica DESLIGADO, salvo SWAGGER_ENABLED=true (A-80)
# SWAGGER_ENABLED=false
# Tracking de e-mail (pixel/clique): links gerados antes desta data (ISO) são aceitos sem assinatura
# TRACKING_SIGNATURE_CUTOFF=
# Contas sociais (TikTok) — segredos DEDICADOS (recomendado; sem eles caem no JWT_ACCESS_SECRET,
# e rotacionar o JWT quebraria os tokens salvos): openssl rand -hex 32
# SOCIAL_ACCOUNTS_ENCRYPTION_KEY=   # cifra access/refresh tokens das contas sociais no banco
# SOCIAL_OAUTH_STATE_SECRET=        # assina o `state` do OAuth
# SOCIAL_OAUTH_RETURN_TO_DEFAULT=   # URL de retorno padrão após o OAuth
# SOCIAL_OAUTH_ALLOWED_RETURN_TO_ORIGINS=   # origens permitidas p/ return_to (separadas por vírgula)
# TikTok (só se usar agendamento de posts)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=
# TIKTOK_OAUTH_SCOPES=
# TIKTOK_OAUTH_DISABLE_AUTO_AUTH=false
# TIKTOK_OAUTH_AUTHORIZE_ENDPOINT=
# TIKTOK_OAUTH_TOKEN_ENDPOINT=
# TIKTOK_USER_INFO_ENDPOINT=
# TIKTOK_CREATOR_INFO_ENDPOINT=
# TIKTOK_DIRECT_POST_ENDPOINT=
# TIKTOK_PHOTO_POST_ENDPOINT=
# TIKTOK_STATUS_FETCH_ENDPOINT=
# NÃO deixe vazio: o BillingService lança erro no boot. Sem Stripe, use este placeholder inerte (e VITE_STRIPE_ENABLED=false no front)
STRIPE_SECRET_KEY=sk_test_disabled_placeholder

# ---- WhatsApp (OpenWA em Docker, só loopback — ver Deploy.md seção 22) ----
# Gateway com motor Baileys (recomendado: baixa as mídias recebidas)
OPENWA_BAILEYS_URL=http://127.0.0.1:2786/api
OPENWA_BAILEYS_API_KEY=
# Gateway com motor whatsapp-web.js (opcional; não baixa mídia recebida desde jul/2026)
OPENWA_URL=
OPENWA_API_KEY=
# Motor das conexões novas: baileys | wwjs
WHATSAPP_DEFAULT_ENGINE=baileys
# Como o container do OpenWA alcança este back (webhook)
OPENWA_WEBHOOK_BASE=http://host.docker.internal:8000
# Cota de mídia por organização (MB). 2 GB só serve para teste: com 2 números entram ~250 MB/dia e a mídia fica 90 dias.
# Produção usa 25600 (25 GB). Cota cheia = envio dá 413 com aviso e mídia recebida fica "não baixada".
WHATSAPP_MEDIA_QUOTA_MB=2048
# Criptografia em repouso das mensagens e mídias do WhatsApp: "1:<base64 de 32 bytes>" (openssl rand -base64 32).
# Vazio = grava sem cifrar (ok para desenvolvimento). Em produção: gere no servidor e GUARDE UMA CÓPIA —
# sem ela as mensagens não abrem. Para trocar: acrescente "2:<nova>" mantendo a 1 (ver Deploy.md §22.4).
WHATSAPP_DATA_KEYS=

# Notificações push (Web Push / VAPID). Vazio = push desligado (os avisos no painel continuam).
# Gerar no servidor (nunca imprimir a privada): node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k.publicKey);console.log(k.privateKey)"
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:voce@seu-dominio.com

# Pasta de dados do gateway Baileys no host (leitura do nome de exibição em creds.json)
# OPENWA_BAILEYS_DATA_DIR=/opt/openwa-baileys/data
# Plugin WordPress "Tradutor Invisível" (módulo WordPress):
# chave que assina a verificação de licença dos plugins (32 bytes: openssl rand -hex 32).
# Sem ela deriva do JWT_ACCESS_SECRET — mas trocar o JWT pararia os plugins instalados.
WP_PLUGIN_SIGNING_KEY=
# pasta com o código do plugin (default: ../wordpress/tradutor-invisivel a partir de back/)
# WP_PLUGIN_SOURCE_DIR=/opt/pub-mail/wordpress/tradutor-invisivel
# endereço do painel (default: PUBLIC_API_URL sem o "api."), usado no botão "Abrir o Pub Mail" do plugin
# APP_PUBLIC_URL=https://SEU-DOMINIO
# endpoints do tradutor enviados aos plugins, separados por vírgula (só se o Google mudar algo)
# WP_PLUGIN_GOOGLE_ENDPOINTS=
