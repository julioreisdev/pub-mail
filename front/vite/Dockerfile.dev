# Imagem de DESENVOLVIMENTO do front (Vite dev server). Build a partir da RAIZ do repositório.
FROM node:22-bookworm-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app/front/vite
COPY front/vite/package.json front/vite/yarn.lock front/vite/.yarnrc.yml ./
RUN yarn install --immutable
COPY front/vite/ ./
# BROWSER=none: o Vite não tenta abrir navegador dentro do container
ENV BROWSER=none TZ=UTC
EXPOSE 3000
CMD ["yarn", "start"]
